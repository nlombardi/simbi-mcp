table sales_small
	lineageTag: b413e652-6625-4fb9-b4d6-f9c31b7f9922

	measure 'Order Count' = COUNTROWS(sales_small)
		formatString: #,0
		lineageTag: cde777a123ce426ca051

	measure 'Total Revenue' = SUM(sales_small[Revenue])
		formatString: \$#,0.00
		lineageTag: e11615b8d06a4b0e97a5

	measure 'Average Unit Price' = AVERAGE(sales_small[UnitPrice])
		formatString: \$#,0.00
		lineageTag: 1fd2c25a16ea47eb9c4c

	measure 'Revenue Sparkline' =
			VAR _W = 120
			VAR _H = 32
			VAR _Months =
			    GROUPBY(
			        ADDCOLUMNS( ALL( sales_small[OrderDate] ), "@i", YEAR( sales_small[OrderDate] ) * 12 + MONTH( sales_small[OrderDate] ) ),
			        [@i]
			    )
			VAR _Pts =
			    ADDCOLUMNS(
			        _Months,
			        "@v",
			            VAR _i = [@i]
			            RETURN CALCULATE( [Total Revenue], FILTER( ALL( sales_small[OrderDate] ), YEAR( sales_small[OrderDate] ) * 12 + MONTH( sales_small[OrderDate] ) = _i ) ) + 0
			    )
			VAR _MinI = MINX( _Pts, [@i] )
			VAR _MaxI = MAXX( _Pts, [@i] )
			VAR _MinV = MINX( _Pts, [@v] )
			VAR _MaxV = MAXX( _Pts, [@v] )
			VAR _Points =
			    CONCATENATEX(
			        _Pts,
			        FORMAT( DIVIDE( [@i] - _MinI, _MaxI - _MinI ) * ( _W - 4 ) + 2, "0.0", "en-US" ) & "," & FORMAT( _H - 2 - DIVIDE( [@v] - _MinV, _MaxV - _MinV ) * ( _H - 4 ), "0.0", "en-US" ),
			        " ",
			        [@i], ASC
			    )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _W & "' height='" & _H & "' viewBox='0 0 " & _W & " " & _H & "'><polyline fill='none' stroke='%23118DFF' stroke-width='2' stroke-linejoin='round' points='" & _Points & "'/></svg>"
		lineageTag: 7c1e0b2a9f3d4e51a8b6
		dataCategory: ImageUrl

	measure 'Revenue Share Bar' =
			VAR _Share = DIVIDE( [Total Revenue], CALCULATE( [Total Revenue], ALL( sales_small[Category] ) ) )
			VAR _Wd = FORMAT( _Share * 100, "0.0", "en-US" )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='16' viewBox='0 0 100 16'><rect width='100' height='16' rx='3' fill='%23E6E6E6'/><rect width='" & _Wd & "' height='16' rx='3' fill='%23118DFF'/><text x='96' y='12' font-family='Segoe UI' font-size='10' text-anchor='end' fill='%23252423'>" & FORMAT( _Share * 100, "0", "en-US" ) & "%25</text></svg>"
		lineageTag: 3b8f2d6e1a4c4f97b0d2
		dataCategory: ImageUrl

	measure 'Revenue Trend Arrow' =
			VAR _N = 3
			VAR _Last = CALCULATE( MAX( sales_small[OrderDate] ), ALL( sales_small[OrderDate] ) )
			VAR _LastI = YEAR( _Last ) * 12 + MONTH( _Last )
			VAR _Cur = CALCULATE( [Total Revenue], FILTER( ALL( sales_small[OrderDate] ), YEAR( sales_small[OrderDate] ) * 12 + MONTH( sales_small[OrderDate] ) = _LastI ) )
			VAR _Base =
			    DIVIDE(
			        CALCULATE( [Total Revenue], FILTER( ALL( sales_small[OrderDate] ), VAR _i = YEAR( sales_small[OrderDate] ) * 12 + MONTH( sales_small[OrderDate] ) RETURN _i >= _LastI - _N && _i < _LastI ) ),
			        _N
			    )
			VAR _Chg = DIVIDE( _Cur - _Base, _Base )
			VAR _Dir = SWITCH( TRUE(), ISBLANK( _Chg ), 0, _Chg > 0.02, 1, _Chg < -0.02, -1, 0 )
			VAR _Col = SWITCH( _Dir, 1, "%23107C10", -1, "%23D13438", "%23605E5C" )
			VAR _Shape = SWITCH( _Dir, 1, "<path d='M7 2 L13 11 L1 11 Z'", -1, "<path d='M1 5 L13 5 L7 14 Z'", "<path d='M1 7 H13 V9 H1 Z'" )
			VAR _Txt = IF( ISBLANK( _Chg ), "n/a", SUBSTITUTE( FORMAT( _Chg, "+0%;-0%;0%", "en-US" ), "%", "%25" ) )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='64' height='16' viewBox='0 0 64 16'>" & _Shape & " fill='" & _Col & "'/><text x='18' y='12' font-family='Segoe UI' font-size='11' font-weight='600' fill='" & _Col & "'>" & _Txt & "</text></svg>"
		lineageTag: 5d2a9c4e7b1f4a3c8e60
		dataCategory: ImageUrl

	measure 'Revenue Sparkline Hex' = SUBSTITUTE( [Revenue Sparkline], "%23", "#" )
		lineageTag: 2f6c8a1e5d9b4c07a3e4
		dataCategory: ImageUrl

	measure 'Revenue vs Avg Badge' =
			VAR _Avg = AVERAGEX( ALL( sales_small[Category] ), [Total Revenue] )
			VAR _Var = [Total Revenue] - _Avg
			VAR _Pos = _Var >= 0
			VAR _Bg = IF( _Pos, "%23DFF6DD", "%23FDE7E9" )
			VAR _Fg = IF( _Pos, "%23107C10", "%23A4262C" )
			VAR _Txt = IF( _Pos, "+", "-" ) & FORMAT( ABS( _Var ), "$#,0", "en-US" )
			RETURN
			    IF(
			        HASONEVALUE( sales_small[Category] ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='84' height='18' viewBox='0 0 84 18'><rect width='84' height='18' rx='9' fill='" & _Bg & "'/><text x='42' y='13' font-family='Segoe UI' font-size='11' font-weight='600' text-anchor='middle' fill='" & _Fg & "'>" & _Txt & "</text></svg>"
			    )
		lineageTag: 9e4b1d7a3c6f4e28b5a1
		dataCategory: ImageUrl

	column OrderID
		dataType: int64
		formatString: 0
		lineageTag: 3d8d177a-e3ad-4096-a06e-d81fef7c6135
